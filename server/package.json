{
  "name": "council-of-foods-server",
  "author": "Nonhuman Nonsense",
  "license": "CC BY-NC 4.0",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server/server.js",
    "build": "node node_modules/@typescript/native/bin/tsc && tsc-alias",
    "e2e-server": "cross-env NODE_ENV=test tsx server.ts",
    "dev": "cross-env NODE_ENV=development USE_TEST_OPTIONS=true nodemon --exec \"node node_modules/@typescript/native/bin/tsc --noEmit && tsx server.ts\"",
    "proto": "cross-env NODE_ENV=prototype node dist/server/server.js",
    "protodev": "cross-env NODE_ENV=prototype nodemon --exec \"node node_modules/@typescript/native/bin/tsc --noEmit && tsx server.ts\"",
    "type-check": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "npm run type-check && vitest run",
    "test:watch": "npm run type-check && vitest",
    "test:unit": "npm run type-check && vitest run --config vitest.unit.config.ts",
    "test:integration": "npm run type-check && vitest run --config vitest.integration.config.ts",
    "test:fast": "cross-env TEST_MODE=fast npm run test",
    "test:full": "cross-env TEST_MODE=full npm run test",
    "test:coverage": "npm run test -- --coverage",
    "footprint:check": "node ../scripts/ecologits/update.mjs --check",
    "footprint:update": "node ../scripts/ecologits/update.mjs",
    "letters:corpus": "cross-env NODE_ENV=production tsx scripts/letters/generateCorpus.ts",
    "letters:export": "cross-env NODE_ENV=production tsx scripts/letters/exportForPrint.ts",
    "letters:print": "cross-env NODE_ENV=production tsx scripts/letters/printLetters.ts",
    "letters:eval": "cross-env NODE_ENV=production tsx scripts/letters/evalLetters.ts",
    "voices:loudness": "cross-env NODE_ENV=production tsx scripts/voiceLoudness.ts",
    "logs": "cross-env NODE_ENV=production tsx scripts/clientLogs.ts",
    "network": "cross-env NODE_ENV=production tsx scripts/networkLog.ts",
    "usage": "cross-env NODE_ENV=production tsx scripts/usageReport.ts",
    "prod": "node scripts/prod.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "docker": "node scripts/docker.mjs",
    "push": "node scripts/push.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "mongodb": "^7.7.0",
    "music-metadata": "^12.3.2",
    "openai": "^7.45.1",
    "remove-markdown": "^0.8.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/remove-markdown": "^0.3.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.4",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "nodemonConfig": {
    "watch": [
      "server.ts",
      "src",
      "global-options.json",
      "test-options.json",
      "../shared",
      ".env"
    ],
    "ext": "ts,js,json"
  }
}
