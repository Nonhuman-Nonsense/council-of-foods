COUNCIL_DB_URL=mongodb://username:password@mongo:27017
COUNCIL_DB_PREFIX=
COUNCIL_OPENAI_API_KEY=
# Dev anchor port (default 3001). Vite dev uses 5173 + (PORT - 3001).
# Example: PORT=3002 → server on 3002, Vite on 5174 (for council-of-forest).
PORT=
NODE_ENV=
COUNCIL_ERRORBOT=
COUNCIL_ERRORBOT_KEY=
# Email via Brevo (transactional API). Sender domain must be authenticated in Brevo.
COUNCIL_BREVO_API_KEY=
COUNCIL_MAIL_FROM=Council of Foods <council@council-of-foods.com>
# Installation bridges (printer alerts). Key is shared with bridges' alerts.env.
COUNCIL_BRIDGE_KEY=
# JSON array, e.g. [{"id":"example-museum","name":"Example Museum","alertEmails":["staff@example.org"],"timezone":"Europe/Stockholm","openingHours":{"days":["wed","thu","fri","sat","sun"],"from":"12:00","to":"16:00"}}]
COUNCIL_VENUES=
# Smart plugs (Shelly) posting room electricity for the footprint meter; same key in each plug's script.
COUNCIL_ROOM_POWER_KEY=
TEST_MODE=
USE_TEST_OPTIONS=
#These are not really needed here, but in the environment for MongoDB.
#just keep it here for ref
#MONGO_INITDB_ROOT_USERNAME=username
#MONGO_INITDB_ROOT_PASSWORD=password
