COUNCIL_DB_URL=mongodb://username:password@mongo:27017
COUNCIL_DB_PREFIX=
COUNCIL_OPENAI_API_KEY=
# Dev anchor port (default 3001). Vite dev uses 5173 + (PORT - 3001).
# Example: PORT=3002 → server on 3002, Vite on 5174 (for council-of-forest).
PORT=
NODE_ENV=
COUNCIL_ERRORBOT=
COUNCIL_ERRORBOT_KEY=
# Email via Brevo (transactional API). Sender domain must be authenticated in Brevo.
COUNCIL_BREVO_API_KEY=
COUNCIL_MAIL_FROM=Council of Foods <council@council-of-foods.com>
# Meetings' letters: off (queue, send nothing; the default), test (all to COUNCIL_LETTERS_TEST_TO),
# live (to the recipients). See docs/council-letters.md.
COUNCIL_LETTERS=off
COUNCIL_LETTERS_TEST_TO=
# Secret in the webhook URLs Brevo posts replies and delivery events to (16+ characters).
COUNCIL_LETTERS_WEBHOOK_SECRET=
# One key for installations: pasted on #staff (bridge, printer alerts) and into each room power
# plug's script. 16+ characters.
COUNCIL_INSTALLATION_KEY=
# JSON array, e.g. [{"id":"example-museum","name":"Example Museum","alertEmails":["staff@example.org"],"timezone":"Europe/Stockholm","openingHours":{"days":["wed","thu","fri","sat","sun"],"from":"12:00","to":"16:00"},"plugs":[{"plug":1,"label":"Projector"},{"plug":2,"label":"Computer"}]}]
COUNCIL_VENUES=
TEST_MODE=
USE_TEST_OPTIONS=
#These are not really needed here, but in the environment for MongoDB.
#just keep it here for ref
#MONGO_INITDB_ROOT_USERNAME=username
#MONGO_INITDB_ROOT_PASSWORD=password
