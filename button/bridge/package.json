{
  "name": "council-button-bridge",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "Local USB serial to WebSocket bridge for Council installation buttons",
  "main": "dist/button/bridge/src/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/button/bridge/src/index.js",
    "dev": "tsx src/index.ts",
    "dev:mock": "BUTTON_MOCK_SERIAL=1 BRIDGE_MOCK_PRINTER=1 tsx src/index.ts",
    "stop": "node scripts/stop-dev.mjs",
    "restart:mock": "npm run stop && BUTTON_MOCK_SERIAL=1 BRIDGE_MOCK_PRINTER=1 tsx src/index.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:install-smoke": "install/macos/smoke-bundle.sh"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "serialport": "^13.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
