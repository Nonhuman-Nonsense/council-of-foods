    "vite-plugin-svgr": "^5.2.0",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "predev": "node scripts/sync-character-media.mjs",
    "prebuild": "node scripts/sync-character-media.mjs",
    "dev": "vite",
    "generate-icons": "node scripts/generate-icons.mjs",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "analyze": "vite build --config vite.config.analyze.ts --mode analyze",
    "type-check": "tsc -p tsconfig.json --noEmit",
